{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-new-score-site",
  "main": "./_worker.js",
  "compatibility_date": "2026-09-15",
  "secrets": {
    "required": [
      "FootballScoresWebsite"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
