{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-new-score-site",
  "main": "./_worker.js",
  "compatibility_date": "2026-09-15",

  "cache": {
    "enabled": true
  },

  "secrets": {
    "required": [
      "FootballScoresWebsite",
      "FootballDataToken"
    ]
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
